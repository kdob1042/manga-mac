{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kdob1042/story-library/contracts/library/catalog.schema.json",
  "title": "story-library/v1 catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "authorityUntil", "works"],
  "properties": {
    "format": { "const": "story-library/v1" },
    "authorityUntil": { "const": "M8" },
    "notes": { "type": "string", "maxLength": 4000 },
    "works": {
      "type": "array",
      "items": { "$ref": "#/$defs/work" }
    }
  },
  "$defs": {
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "root", "formats", "manuscriptFormat", "readAdapters", "authority", "origin", "importStatus"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "root": { "type": "string", "pattern": "^works/[a-z][a-z0-9-]{0,62}$" },
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["novel", "manga"] }
        },
        "manuscriptFormat": { "enum": ["story-source/v1", "novel-source/v1", "investor-life-source/v1", "schema-1", "schema-4"] },
        "readAdapters": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["story-source/v1", "novel-source/v1", "investor-life-source/v1", "schema-1", "schema-4"] }
        },
        "authority": { "enum": ["origin", "library"] },
        "origin": { "$ref": "#/$defs/origin" },
        "importStatus": { "enum": ["pending-access", "pending-identification", "pending-import", "imported", "verified"] },
        "notes": { "type": "string", "maxLength": 4000 }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "ref": { "type": "string", "minLength": 1, "maxLength": 200 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "structureCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "manifestPath": { "type": "string", "minLength": 1 },
        "accessible": { "type": "boolean" }
      }
    }
  }
}
