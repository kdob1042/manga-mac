{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "live-manga"
    },
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "2.0.0"
      ]
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9:_-]{1,128}$"
    },
    "workId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9:_-]{1,128}$"
    },
    "episodeId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9:_-]{1,128}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^<>\\u0000-\\u0008]+$"
    },
    "language": {
      "enum": [
        "ja",
        "en"
      ]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4000,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "releaseId",
    "workId",
    "episodeId",
    "title",
    "language",
    "pages",
    "assets"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "minimum": 1e-07
        },
        "height": {
          "type": "number",
          "minimum": 1e-07
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/[a-f0-9]{64}\\.(png|jpg|webp|mp4)$"
        },
        "mime": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "video/mp4"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "codec": {
          "const": "h264"
        },
        "audio": {
          "const": false
        }
      },
      "required": [
        "id",
        "sha256",
        "path",
        "mime",
        "bytes",
        "width",
        "height"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mime": {
                "const": "video/mp4"
              }
            }
          },
          "then": {
            "required": [
              "duration",
              "codec",
              "audio"
            ]
          },
          "else": {
            "properties": {
              "bytes": {
                "maximum": 33554432
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "duration"
                  ]
                },
                {
                  "required": [
                    "codec"
                  ]
                },
                {
                  "required": [
                    "audio"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9:_-]{1,128}$"
        },
        "frame": {
          "$ref": "#/$defs/rect"
        },
        "artRect": {
          "$ref": "#/$defs/rect"
        },
        "poster": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^<>\\u0000-\\u0008]+$"
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "asset": {
              "type": "string"
            },
            "end": {
              "const": "poster"
            }
          },
          "required": [
            "asset",
            "end"
          ]
        }
      },
      "required": [
        "id",
        "frame",
        "artRect",
        "poster",
        "text"
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9:_-]{1,128}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "art": {
          "type": "string"
        },
        "overlay": {
          "type": "string"
        },
        "fallback": {
          "type": "string"
        },
        "panels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/panel"
          }
        }
      },
      "required": [
        "id",
        "width",
        "height",
        "art",
        "overlay",
        "fallback",
        "panels"
      ]
    },
    "transformedRect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 1e-07
        },
        "height": {
          "type": "number",
          "minimum": 1e-07
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "quad": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 8192
        }
      }
    },
    "panelV2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9:_-]{1,128}$"
        },
        "frame": {
          "$ref": "#/$defs/rect"
        },
        "artRect": {
          "$ref": "#/$defs/transformedRect"
        },
        "poster": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^<>\\u0000-\\u0008]+$"
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "asset": {
              "type": "string"
            },
            "end": {
              "const": "poster"
            }
          },
          "required": [
            "asset",
            "end"
          ]
        },
        "clip": {
          "$ref": "#/$defs/quad"
        }
      },
      "required": [
        "id",
        "frame",
        "artRect",
        "poster",
        "text",
        "clip"
      ]
    },
    "pageV2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9:_-]{1,128}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "art": {
          "type": "string"
        },
        "overlay": {
          "type": "string"
        },
        "fallback": {
          "type": "string"
        },
        "panels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/panelV2"
          }
        }
      },
      "required": [
        "id",
        "width",
        "height",
        "art",
        "overlay",
        "fallback",
        "panels"
      ]
    }
  },
  "$comment": "Structural schema. validate.mjs also enforces cross references, identity, ratios, boundaries and total package size.",
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.0.0"
          }
        }
      },
      "then": {
        "properties": {
          "pages": {
            "items": {
              "$ref": "#/$defs/page"
            }
          }
        }
      },
      "else": {
        "properties": {
          "pages": {
            "items": {
              "$ref": "#/$defs/pageV2"
            }
          }
        }
      }
    }
  ]
}
